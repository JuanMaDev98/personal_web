# ===== Database =====
# Local: usar docker-compose (postgresql://postgres:postgres@localhost:5432/juanmacrypto)
# Produccion: Neon, Supabase u otro Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/juanmacrypto"

# ===== NextAuth (Auth.js v5) =====
# Generar con: openssl rand -base64 32
AUTH_SECRET="CAMBIAR_POR_SECRETO_DE_32_CHARS_BASE64"
# URL canonica de la app (donde corre el HUB)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ===== Google OAuth =====
# Crear en https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ===== Email transaccional (Resend) =====
# Crear en https://resend.com (free tier: 3000 emails/mes)
RESEND_API_KEY=""
CONTACT_EMAIL="hola@manko.blog"

# ===== Cron job (proteccion del endpoint) =====
# Cualquier string aleatorio largo. cron-job.org lo incluira como ?secret=XXX en la URL
CRON_SECRET="CAMBIAR_POR_STRING_ALEATORIO_LARGO"

# ===== Public site URL =====
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ===== YouTube Data API v3 (opcional, para auto-refresh de subs) =====
# Crear API key en https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID="UCElCoULDa68Yzqi1slcWvKA"

# ===== Telegram (opcional, para auto-refresh de members) =====
# Crear bot con @BotFather, agregar al canal/grupo como admin
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_USERNAME="JuanMaYoutube"
TELEGRAM_GROUP_USERNAME="JuanMaCryptoYoutube"

# ===== Discord (opcional, para auto-refresh de members) =====
# Crear bot en https://discord.com/developers/applications
# Habilitar Server Members Intent y agregar bot al servidor
DISCORD_BOT_TOKEN=""
DISCORD_INVITE_CODE="juanma.98"
